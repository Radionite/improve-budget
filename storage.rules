rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Facturen, foto's en bankafschriften per huishouden: alleen voor leden.
    match /households/{hid}/{allPaths=**} {
      allow read, delete: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(hid)).data.members;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(hid)).data.members
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
